# Spacetime (local server by default - never point this at the shared Maincloud db from Photon
# during development; only Pablo publishes/owns the shared one)
SPACETIME_HOST=http://127.0.0.1:3000
SPACETIME_DB=pdm

# Which Spectrum provider to use. "terminal" needs NO credentials at all - this is the dry-run
# mode. Switch to "imessage" only once you have real Photon credentials below.
SPECTRUM_PROVIDER=terminal

# Only needed when SPECTRUM_PROVIDER=imessage. Get these from the Photon dashboard - see
# PHOTON_SETUP.md for the manual steps. Never commit real values here.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# The ONE phone number this bridge will talk to in imessage mode - anyone else gets a polite
# decline. This is strictly a one-on-one operator channel, no group chat, no roles.
OWNER_PHONE=

# Optional: real LLM tool-calling + structured interview extraction. Without this set, the
# concierge falls back to rule-based responders (keyword matching) that still call every tool
# correctly - the whole system works with zero external accounts. Set this to use a real model
# for richer free-text understanding.
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# How long an open interview waits before nudging once, then marking itself complete regardless
# (so the workflow never stalls on a quiet operator). Milliseconds.
INTERVIEW_TIMEOUT_MS=300000
INTERVIEW_NUDGE_BEFORE_MS=60000
